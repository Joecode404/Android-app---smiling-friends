@Composable
fun PopStickerWithSparkles(sticker: Sticker, index: Int) {
    var visible by remember { mutableStateOf(false) }

    // stagger reveal
    LaunchedEffect(Unit) {
        delay(160L * index)
        visible = true
    }

    // BIG noticeable pop
    val scale by animateFloatAsState(
        targetValue = if (visible) 1f else 0f,
        animationSpec = spring(
            dampingRatio = 0.35f,      // Strong overshoot
            stiffness = Spring.StiffnessVeryLow
        ),
        label = ""
    )

    // Slide upward entrance
    val offsetY by animateDpAsState(
        targetValue = if (visible) 0.dp else 40.dp,
        animationSpec = tween(650, easing = LinearOutSlowInEasing),
        label = ""
    )

    // Subtle rotation for extra “pop”
    val rotation by animateFloatAsState(
        targetValue = if (visible) 0f else -35f,
        animationSpec = tween(600, easing = LinearOutSlowInEasing),
        label = ""
    )

    Box(
        modifier = Modifier
            .offset(y = offsetY)
            .graphicsLayer {
                scaleX = scale
                scaleY = scale
                rotationZ = rotation
            },
        contentAlignment = Alignment.Center
    ) {
        if (visible) SparkleBurst()
        EmojiSticker(sticker)
    }
}


