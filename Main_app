// ---------- BREATHING SCREEN ----------
@Composable
fun BreathingScreen(
    playAll: Boolean,
    onNext: () -> Unit,
    darkMode: Boolean,
    onBack: () -> Unit
) {
    var isRunning by remember { mutableStateOf(false) }
    var phase by remember { mutableStateOf("Tap Anywhere to Start") }
    var scale by remember { mutableStateOf(1f) }

    // Unified background colors (matches other screens)
    val baseBg = if (darkMode) Color(0xFF3A3A5E) else Color(0xFFFFF8F0)

    var bgColor by remember { mutableStateOf(baseBg) }
    var roundCount by remember { mutableStateOf(0) }

    val animatedScale by animateFloatAsState(
        targetValue = scale,
        animationSpec = tween(3000),
        label = ""
    )

    val animatedColor by animateColorAsState(
        targetValue = bgColor,
        animationSpec = tween(3000),
        label = ""
    )

    // Breathing cycle colors (pastel & dark harmonized)
    val inhaleColor = if (darkMode) Color(0xFF4E4E80) else Color(0xFFE0F7FA)
    val holdColor = if (darkMode) Color(0xFF5C5C91) else Color(0xFFFFF3B0)
    val exhaleColor = if (darkMode) Color(0xFF3A3A5E) else Color(0xFFFFD1DC)

    // Text colors to match all other screens
    val textColor = if (darkMode) Color(0xFFFDF6F0) else Color(0xFF3E3E3E)

    // Breathing animation loop
    LaunchedEffect(isRunning) {
        if (isRunning) {
            roundCount = 0
            while (isActive && roundCount < 3) {

                phase = "Breathe in..."
                scale = 1.8f
                bgColor = inhaleColor
                delay(3000)

                phase = "Hold..."
                bgColor = holdColor
                delay(2000)

                phase = "Breathe out..."
                scale = 1f
                bgColor = exhaleColor
                delay(3000)

                phase = "Rest..."
                bgColor = baseBg
                delay(2000)

                roundCount++
            }

            isRunning = false
            onNext()
        } else {
            phase = "Tap Anywhere to Start"
            scale = 1f
            bgColor = baseBg
        }
    }

    Surface(
        modifier = Modifier
            .fillMaxSize()
            .background(animatedColor)
            .clickable { if (!isRunning) isRunning = true },
        color = Color.Transparent
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(28.dp),
            verticalArrangement = Arrangement.SpaceEvenly,
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            // Title
            Text(
                "Let's take calm breaths 🌬️",
                color = textColor,
                fontSize = 26.sp,
                fontWeight = FontWeight.Bold,
                textAlign = TextAlign.Center
            )

            // Animated Circle
            Box(
                modifier = Modifier
                    .size(180.dp)
                    .scale(animatedScale)
                    .background(
                        color = if (darkMode) Color(0xFF6A5ACD) else Color(0xFFFFD1DC),
                        shape = CircleShape
                    )
            )

            // Breathing phase text
            Text(
                phase,
                color = textColor,
                fontSize = 28.sp,
                fontWeight = FontWeight.SemiBold
            )

            // Back + Next buttons
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween
            ) {

                Button(
                    onClick = onBack,
                    colors = ButtonDefaults.buttonColors(
                        containerColor = if (darkMode) Color(0xFF6A6A80) else Color(0xFFE0E0E0)
                    ),
                    shape = RoundedCornerShape(16.dp)
                ) {
                    Text("◀️ Back", color = Color.Black)
                }

                Button(
                    onClick = onNext,
                    colors = ButtonDefaults.buttonColors(
                        containerColor = if (darkMode) Color(0xFF6A5ACD) else Color(0xFFFFD1DC)
                    ),
                    shape = RoundedCornerShape(16.dp)
                ) {
                    Text("Next →", color = Color.Black)
                }
            }
        }
    }
}



// ---------- DOODLE SCREEN ----------
@Composable
fun DoodleScreen(
    playAll: Boolean,
    onNext: () -> Unit,
    darkMode: Boolean,
    onBack: () -> Unit
) {
    val doodlePrompts = listOf(
        "Draw a rainbow 🌈","Draw your pet 🐶","Draw your family 👨‍👩‍👧‍👦",
        "Draw something that makes you smile 😀","Draw your favorite place 🏖️",
        "Draw your best friend 💕","Draw a happy sun ☀️","Draw your dream house 🏠"
    )

    var currentPrompt by remember { mutableStateOf(doodlePrompts.random()) }
    var paths by remember { mutableStateOf(listOf<Pair<List<Offset>, Color>>()) }
    var currentPath by remember { mutableStateOf(listOf<Offset>()) }
    var currentColor by remember { mutableStateOf(Color(0xFF81D4FA)) } // default pastel blue

    // ---- Theme-consistent colors ----
    val bgColor = if (darkMode) Color(0xFF3A3A5E) else Color(0xFFFFF0F5)
    val textColor = if (darkMode) Color(0xFFFDF6F0) else Color(0xFF3E3E3E)
    val borderSelected = if (darkMode) Color(0xFFFDF6F0) else Color(0xFF3E3E3E)
    val borderDefault = if (darkMode) Color(0xFF8A8AB2) else Color.Gray
    val buttonPrimary = if (darkMode) Color(0xFF6A5ACD) else Color(0xFFFFD1DC)
    val buttonSecondary = if (darkMode) Color(0xFF6A6A80) else Color(0xFFE0E0E0)

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = bgColor
    ) {
        Box(
            modifier = Modifier
                .fillMaxSize()
                .pointerInput(currentColor) {
                    detectDragGestures(
                        onDragStart = { offset -> currentPath = listOf(offset) },
                        onDrag = { change, _ -> currentPath = currentPath + change.position },
                        onDragEnd = {
                            paths = paths + listOf(currentPath to currentColor)
                            currentPath = emptyList()
                        }
                    )
                }
        ) {

            // DRAWING CANVAS
            Canvas(modifier = Modifier.fillMaxSize()) {
                paths.forEach { (pathPoints, color) ->
                    val path = Path().apply {
                        if (pathPoints.isNotEmpty())
                            moveTo(pathPoints.first().x, pathPoints.first().y)
                        for (p in pathPoints.drop(1)) lineTo(p.x, p.y)
                    }
                    drawPath(
                        path = path,
                        color = color,
                        style = Stroke(10f, cap = StrokeCap.Round, join = StrokeJoin.Round)
                    )
                }

                val currentDrawingPath = Path().apply {
                    if (currentPath.isNotEmpty())
                        moveTo(currentPath.first().x, currentPath.first().y)
                    for (p in currentPath.drop(1)) lineTo(p.x, p.y)
                }

                drawPath(
                    path = currentDrawingPath,
                    color = currentColor,
                    style = Stroke(10f, cap = StrokeCap.Round, join = StrokeJoin.Round)
                )
            }

            // UI Overlay
            Column(
                modifier = Modifier
                    .align(Alignment.TopCenter)
                    .padding(16.dp),
                horizontalAlignment = Alignment.CenterHorizontally
            ) {

                Text(
                    "Doodle Time 🎨",
                    color = textColor,
                    fontSize = 26.sp,
                    fontWeight = FontWeight.Bold
                )

                Spacer(modifier = Modifier.height(8.dp))

                Text(
                    currentPrompt,
                    color = textColor,
                    fontSize = 18.sp,
                    textAlign = TextAlign.Center,
                    modifier = Modifier.padding(bottom = 12.dp)
                )

                // COLOR PICKER
                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
                    val colors = listOf(
                        Color(0xFFFFB3B3), // pastel red
                        Color(0xFFFFF59D), // pastel yellow
                        Color(0xFFA5D6A7), // pastel green
                        Color(0xFF81D4FA), // pastel blue
                        Color(0xFFE1BEE7)  // pastel purple
                    )

                    colors.forEach { color ->
                        Box(
                            modifier = Modifier
                                .size(36.dp)
                                .background(color, CircleShape)
                                .border(
                                    if (currentColor == color) 3.dp else 1.dp,
                                    if (currentColor == color) borderSelected else borderDefault,
                                    CircleShape
                                )
                                .clickable { currentColor = color }
                        )
                    }

                    // ERASER
                    Button(
                        onClick = { currentColor = bgColor },
                        colors = ButtonDefaults.buttonColors(containerColor = bgColor),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Text("Eraser 🩹", color = textColor)
                    }
                }

                Spacer(modifier = Modifier.height(12.dp))

                // ACTION BUTTONS
                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {

                    Button(
                        onClick = { currentPrompt = doodlePrompts.random() },
                        colors = ButtonDefaults.buttonColors(containerColor = buttonPrimary),
                        shape = RoundedCornerShape(16.dp)
                    ) {
                        Text("New Idea 💡", color = Color.Black)
                    }

                    Button(
                        onClick = { paths = emptyList() },
                        colors = ButtonDefaults.buttonColors(containerColor = buttonSecondary),
                        shape = RoundedCornerShape(16.dp)
                    ) {
                        Text("Clear", color = Color.Black)
                    }

                    Button(
                        onClick = onNext,
                        colors = ButtonDefaults.buttonColors(containerColor = buttonPrimary),
                        shape = RoundedCornerShape(16.dp)
                    ) {
                        Text("Next →", color = Color.Black)
                    }
