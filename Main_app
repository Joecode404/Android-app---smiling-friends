@Composable
fun SparkleBurst() {
    val sparkles = remember {
        List(10) {
            val angle = Random.nextDouble(0.0, 360.0)
            val dist = Random.nextDouble(35.0, 70.0)
            val size = Random.nextInt(10, 20)
            Triple(angle, dist, size)
        }
    }

    sparkles.forEachIndexed { idx, (angle, dist, size) ->
        var show by remember { mutableStateOf(true) }
        val anim = remember { Animatable(0f) }

        LaunchedEffect(Unit) {
            anim.animateTo(
                targetValue = 1f,
                animationSpec = tween(
                    durationMillis = 850 + idx * 50,
                    easing = FastOutSlowInEasing
                )
            )
            show = false
        }

        if (show) {
            val x = (cos(Math.toRadians(angle)) * dist).dp
            val y = (sin(Math.toRadians(angle)) * dist).dp
            val alpha = 1f - anim.value

            Box(
                modifier = Modifier
                    .offset(x = x * anim.value, y = y * anim.value)
                    .size(size.dp)
                    .background(
                        color = if (alpha > 0f) Color.White.copy(alpha = alpha) else Color.Transparent,
                        shape = CircleShape
                    )
            )
        }
    }
}

