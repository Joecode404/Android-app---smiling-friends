// Memory Game //
data class MemoryCard(
    val emoji: String,
    val isFaceUp: Boolean = false,
    val isMatched: Boolean = false
)

@Composable
fun MemoryGameScreen(
    darkMode: Boolean,
    onNext: () -> Unit,
    onBack: () -> Unit
) {
    val emojis = listOf("🌸","🌞","🌙","🌈","🍀","☁️","🌊","🍎","⭐")
    val pairEmojis = emojis.shuffled().take(4)
    val oddEmoji = (emojis - pairEmojis).random()
    val cardList = (pairEmojis + pairEmojis + listOf(oddEmoji)).shuffled()

    var cards by remember { mutableStateOf(cardList.map { MemoryCard(it) }) }
    var firstCardIndex by remember { mutableStateOf<Int?>(null) }
    var secondCardIndex by remember { mutableStateOf<Int?>(null) }
    var cardsToFlipBack by remember { mutableStateOf<Pair<Int, Int>?>(null) }

    // --- Colors ---
    val backgroundColor = if (darkMode) Color(0xFF3A3A5E) else Color(0xFFFFF0F5)
    val cardBackColor = if (darkMode) Color(0xFF6A5ACD) else Color(0xFFFFD1DC)
    val cardFrontColor = if (darkMode) Color(0xFFF3E5F5) else Color(0xFFE0D0E0)
    val textColor = if (darkMode) Color(0xFFFDF6F0) else Color(0xFF3E3E3E)
    val buttonTextColor = Color.Black

    // ---- Responsive sizing ----
    val configuration = LocalConfiguration.current
    val screenWidth = configuration.screenWidthDp.dp
    val screenHeight = configuration.screenHeightDp.dp
    val columns = 3
    val rows = 3
    val spacing = 12.dp

    // New: reserve space at bottom so Back button never overlaps tiles
    val backButtonHeight = 56.dp
    val extraBottomPadding = backButtonHeight + 32.dp

    val horizontalPadding = 32.dp
    val verticalPadding = 32.dp + extraBottomPadding

    val maxCardWidth = (screenWidth - horizontalPadding - (spacing * (columns - 1))) / columns
    val maxCardHeight = (screenHeight - verticalPadding - (spacing * (rows - 1))) / rows
    val cardSize = minOf(maxCardWidth, maxCardHeight)

    // Flip back unmatched cards after delay
    if (cardsToFlipBack != null) {
        LaunchedEffect(cardsToFlipBack) {
            delay(1000)
            cards = cards.mapIndexed { i, c ->
                if (i == cardsToFlipBack!!.first || i == cardsToFlipBack!!.second)
                    c.copy(isFaceUp = false)
                else c
            }
            firstCardIndex = null
            secondCardIndex = null
            cardsToFlipBack = null
        }
    }

    val matchedPairs = cards.count { it.isMatched } / 2
    val celebrationScale = remember { Animatable(0f) }

    // Celebration animation
    if (matchedPairs == 4) {
        LaunchedEffect(Unit) {
            celebrationScale.animateTo(1.5f, animationSpec = tween(300))
            celebrationScale.animateTo(1f, animationSpec = tween(300))
            celebrationScale.animateTo(1.3f, animationSpec = tween(200))
            celebrationScale.animateTo(1f, animationSpec = tween(200))
            delay(500)
            onNext()
        }
    }

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = backgroundColor
    ) {
        Box(modifier = Modifier.fillMaxSize()) {

            // Main game layout with extra bottom padding
            Column(
                modifier = Modifier
                    .align(Alignment.Center)
                    .padding(bottom = extraBottomPadding),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.spacedBy(spacing)
            ) {
                Text(
                    "Match all of the pairs! 🧩",
                    color = textColor,
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Bold
                )

                Spacer(Modifier.height(16.dp))

                Column(verticalArrangement = Arrangement.spacedBy(spacing)) {
                    for (row in 0 until rows) {
                        Row(horizontalArrangement = Arrangement.spacedBy(spacing)) {
                            for (col in 0 until columns) {
                                val index = row * columns + col
                                if (index >= cards.size) continue
                                val card = cards[index]

                                MemoryCardItem(
                                    card = card,
                                    cardBackColor = cardBackColor,
                                    cardFrontColor = cardFrontColor,
                                    cardSize = cardSize,
                                    onClick = {
                                        if (card.isFaceUp || card.isMatched) return@MemoryCardItem
                                        if (firstCardIndex == null) {
                                            firstCardIndex = index
                                            cards = cards.mapIndexed { i, c ->
                                                if (i == index) c.copy(isFaceUp = true) else c
                                            }
                                        } else if (secondCardIndex == null) {
                                            secondCardIndex = index
                                            cards = cards.mapIndexed { i, c ->
                                                if (i == index) c.copy(isFaceUp = true) else c
                                            }
                                            val first = firstCardIndex!!
                                            val second = index
                                            if (cards[first].emoji == cards[second].emoji) {
                                                cards = cards.mapIndexed { i, c ->
                                                    if (i == first || i == second) c.copy(isMatched = true)
                                                    else c
                                                }
                                                firstCardIndex = null
                                                secondCardIndex = null
                                            } else {
                                                cardsToFlipBack = first to second
                                            }
                                        }
                                    }
                                )
                            }
                        }
                    }
                }
            }

            // Celebration Text
            if (matchedPairs == 4) {
                Text(
                    "Well done! 🎉",
                    color = textColor,
                    fontSize = 32.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier
                        .align(Alignment.Center)
                        .scale(celebrationScale.value)
                )
            }

            // Back button (fixed spacing, never overlaps grid now)
            Button(
                onClick = onBack,
                modifier = Modifier
                    .align(Alignment.BottomCenter)
                    .padding(bottom = 16.dp),
                colors = ButtonDefaults.buttonColors(containerColor = cardBackColor)
            ) {
                Text("Back", color = buttonTextColor)
            }
        }
    }
}
@Composable
fun MemoryCardItem(
    card: MemoryCard,
    cardBackColor: Color,
    cardFrontColor: Color,
    cardSize: Dp,
    onClick: () -> Unit
) {
    val rotation = remember { Animatable(0f) }

    LaunchedEffect(card.isFaceUp) {
        rotation.animateTo(
            targetValue = if (card.isFaceUp) 180f else 0f,
            animationSpec = tween(durationMillis = 400)
        )
    }

    Box(
        modifier = Modifier
            .size(cardSize)
            .clickable { onClick() }
            .graphicsLayer {
                rotationY = rotation.value
                cameraDistance = 8 * density
            },
        contentAlignment = Alignment.Center
    ) {
        if (rotation.value <= 90f) {
            Image(
                painter = painterResource(id = R.drawable.mindful_moments),
                contentDescription = "Card Back",
                modifier = Modifier
                    .fillMaxSize()
                    .clip(RoundedCornerShape(12.dp)),
                contentScale = ContentScale.Crop
            )
        } else {
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .background(cardFrontColor, RoundedCornerShape(12.dp)),
                contentAlignment = Alignment.Center
            ) {
                Text(card.emoji, fontSize = cardSize.value.sp / 2)
            }
        }
    }
}

