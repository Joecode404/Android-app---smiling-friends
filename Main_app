@Composable
fun SplashScreen(onSplashFinished: () -> Unit) {
    val infiniteTransition = rememberInfiniteTransition()
    val emojiOffset by infiniteTransition.animateFloat(
        initialValue = 0f, targetValue = 20f,
        animationSpec = infiniteRepeatable(animation = tween(600, easing = LinearEasing), repeatMode = RepeatMode.Reverse),
        label = ""
    )
    val middleOffset by infiniteTransition.animateFloat(
        initialValue = 0f, targetValue = 10f,
        animationSpec = infiniteRepeatable(animation = tween(800, easing = LinearEasing), repeatMode = RepeatMode.Reverse),
        label = ""
    )
    LaunchedEffect(Unit) { delay(3000); onSplashFinished() }

    Surface(modifier = Modifier.fillMaxSize(), color = Color.White) {
        Column(
            modifier = Modifier.fillMaxSize(),
            verticalArrangement = Arrangement.Center,
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Image(painter = painterResource(id = R.drawable.mindful_moments), contentDescription = "App Logo", modifier = Modifier.size(150.dp))
            Spacer(modifier = Modifier.height(16.dp))
            Row(verticalAlignment = Alignment.CenterVertically) {
                Text("Loading ", fontSize = 20.sp, fontWeight = FontWeight.Bold)
                Spacer(modifier = Modifier.width(8.dp))
                Text("😊", modifier = Modifier.offset(y = emojiOffset.dp), fontSize = 20.sp)
                Spacer(modifier = Modifier.width(8.dp))
                Text("😔", modifier = Modifier.offset(y = -emojiOffset.dp), fontSize = 20.sp)
                Spacer(modifier = Modifier.width(8.dp))
                Text("😐", modifier = Modifier.offset(y = middleOffset.dp), fontSize = 20.sp)
            }
        }
    }
}

// ---------- STICKER MODELS & HELPERS ----------
enum class Rarity(val displayName: String, val color: Color) {
    COMMON("Common", Color.LightGray),
    RARE("Rare", Color(0xFF6EC6FF)),
    EPIC("Epic", Color(0xFFFF6ECF))
}

data class Sticker(val emoji: String, val rarity: Rarity)

// Generate a sticker for a given game key (breathing / doodle / memory)
fun generateStickerForGame(gameKey: String): Sticker {
    // Rarity probability: Common 72%, Rare 23%, Epic 5%
    val roll = Random.nextInt(100)
    val rarity = when {
        roll < 72 -> Rarity.COMMON
        roll < 95 -> Rarity.RARE
        else -> Rarity.EPIC
    }

    val emoji = when (gameKey) {
        "breathing" -> listOf("🌬️", "💨", "🍃").random()
        "doodle" -> listOf("🎨", "🖌️", "🖍️").random()
        "memory" -> listOf("🧠", "🧩", "🔮").random()
        else -> listOf("⭐", "✨").random()
    }

    return Sticker(emoji, rarity)
}

