// ---------- APP ROOT (full navigation + sticker collection) ----------
@Composable
fun AppRoot() {
    // screen strings kept for compatibility with most of your existing code
    var screen by remember { mutableStateOf("welcome") }
    var playAll by remember { mutableStateOf(false) }
    var playAllIndex by remember { mutableStateOf(0) }
    var darkMode by remember { mutableStateOf(false) }
    var feedbackText by remember { mutableStateOf("") }
    var feedbackResetKey by remember { mutableStateOf(0) }

    // Sticker collection (in-memory, resets when app restarts)
    val stickerCollection = remember { mutableStateListOf<Sticker>() }

    fun startSingleGame(target: String) {
        playAll = false
        playAllIndex = 0
        screen = target
    }

    fun startPlayAll() {
        playAll = true
        playAllIndex = 0
        screen = "breathing"
    }

    // Called whenever a single game finishes (adds a sticker based on current screen)
    fun onGameFinishedAddStickerAndProceed() {
        // award sticker based on which game was finished
        val awarded = when (screen) {
            "breathing" -> generateStickerForGame("breathing")
            "doodle" -> generateStickerForGame("doodle")
            "memory" -> generateStickerForGame("memory")
            else -> generateStickerForGame("misc")
        }
        stickerCollection.add(awarded)

        // navigation / playAll flow
        if (playAll) {
            playAllIndex++
            screen = when (playAllIndex) {
                1 -> "doodle"
                2 -> "memory"
                else -> { playAll = false; playAllIndex = 0; "feedback" }
            }
        } else {
            screen = "feedback"
        }
    }

    // If feedback submitted, go to congrats screen (no sticker awarded there)
    fun onFeedbackSubmitted() {
        screen = "congrats"
    }

    when (screen) {
        // ---------- Welcome Screen ----------
        "welcome" -> WelcomeScreen(
            onStart = { screen = "mood" },
            onOpenSettings = { screen = "settings" },
            darkMode = darkMode
        )

        // ---------- Mood Screen ----------
        "mood" -> MoodTodayScreen(
            onContinue = { screen = "games" },
            darkMode = darkMode
        )

        // ---------- Games Menu ----------
        "games" -> GamesMenuScreen(
            onBreathing = { startSingleGame("breathing") },
            onDoodle = { startSingleGame("doodle") },
            onReflection = { startSingleGame("memory") },
            onPlayAll = { startPlayAll() },
            darkMode = darkMode
        )

        // ---------- Breathing ----------
        "breathing" -> BreathingScreen(
            playAll = playAll,
            onNext = { onGameFinishedAddStickerAndProceed() },
            darkMode = darkMode,
            onBack = { screen = if (playAll) "games" else "games" }
        )

        // ---------- Doodle ----------
        "doodle" -> DoodleScreen(
            playAll = playAll,
            onNext = { onGameFinishedAddStickerAndProceed() },
            darkMode = darkMode,
            onBack = { screen = if (playAll) "breathing" else "games" }
        )

        // ---------- Memory ----------
        "memory" -> MemoryGameScreen(
            darkMode = darkMode,
            onNext = { onGameFinishedAddStickerAndProceed() },
            onBack = { screen = if (playAll) "doodle" else "games" }
        )

        // ---------- Feedback ----------
        "feedback" -> FeedbackField(
            feedbackText = feedbackText,
            onFeedbackChange = { feedbackText = it },
            darkMode = darkMode,
            onSubmit = {
                onFeedbackSubmitted()

                // Clear text
                feedbackText = ""

                // Force internal state reset in FeedbackField
                feedbackResetKey++

                // Navigate to next screen
                screen = "congrats"
            },
            onBack = { screen = "games" },
            resetKey = feedbackResetKey
        )

        // ---------- Congratulations ----------
        "congrats" -> CongratulationsScreen(
            onBackToStart = {
                screen = "welcome"
                stickerCollection.clear() // optional: clear progress when returning home
            },
            onOpenStickerBook = { screen = "stickerbook" },
            darkMode = darkMode,
            stickers = stickerCollection.toList()
        )

        // ---------- Sticker Book ----------
        "stickerbook" -> StickerBookScreen(
            allStickers = stickerCollection.toList(),
            onBack = { screen = "congrats" },
            darkMode = darkMode
        )

        // ---------- Settings ----------
        "settings" -> SettingsScreen(
            darkMode = darkMode,
            onToggleDarkMode = { darkMode = !darkMode },
            onBack = { screen = "welcome" }
        )
    }
}

